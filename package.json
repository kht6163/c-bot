{
  "name": "c-bot",
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --filter @cbot/server --filter @cbot/web dev",
    "test": "bun test --path-ignore-patterns=example-project",
