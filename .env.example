# Secrets and process location only. Behavioral settings live in $CBOT_HOME/config.yaml.

# Default LLM (SpaceXAI / xAI). Required for model turns.
# Get a key at https://console.x.ai — or paste it in the web UI (설정 → 연결 테스트).
XAI_API_KEY=

# Data root. Empty = ~/.c-bot
CBOT_HOME=

# Bind address and port for the web/API server.
CBOT_HOST=127.0.0.1
CBOT_PORT=3080
