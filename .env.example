# Secrets and process location only. Behavioral settings live in $CBOT_HOME/config.yaml.

# Provider API keys are written to $CBOT_HOME/.env as {ID}_API_KEY when you
# add a provider in Settings → Models. Do not put keys in the web bundle.

# Data root. Empty = ~/.c-bot
CBOT_HOME=

# Bind address and port for the web/API server.
CBOT_HOST=127.0.0.1
CBOT_PORT=3080
